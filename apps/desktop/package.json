{
  "name": "pathology-viewer",
  "version": "1.0.0",
  "description": "Desktop pathology slide viewer with inference",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win:exe": "electron-builder --win dir --x64",
    "dist:win": "electron-builder --win nsis portable --x64",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "build": {
    "appId": "com.bachpath.pathologyviewer",
    "productName": "Bach Path",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**"
    ],
    "extraResources": [
      {
        "from": "../../services/local-api",
        "to": "local-api",
        "filter": [
          "**/*",
          "!**/.venv/**",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": ["nsis", "portable"]
    },
    "linux": {
      "target": ["AppImage"]
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "openseadragon": "^5.0.1"
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^25.1.8"
  }
}
